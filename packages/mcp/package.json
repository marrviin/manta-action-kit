{
  "name": "@manta-action-kit/mcp",
  "description": "MCP server for Manta Action Kit — exposes recorded API calls to agents, bridged to the Chrome extension over a local WebSocket",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marrviin/manta-action-kit.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chrome-extension",
    "ai-agent",
    "api-recording",
    "sandbox-proxy",
    "claude",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "manta-action-kit-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "compile": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.7.0"
  }
}
