{
  "name": "@manta-action-kit/extension",
  "description": "Chrome extension for recording API calls and bridging them to AI agents, built with WXT + React + TypeScript + Tailwind CSS",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @manta-action-kit/mcp build && playwright test -c e2e/playwright.config.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@manta-action-kit/protocol": "workspace:*",
    "antd": "^6.6.1",
    "classnames": "^2.5.1",
    "gifenc": "^1.0.3",
    "i18next": "^26.4.0",
    "mediabunny": "^1.59.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.30",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "onnxruntime-node": "^1.30.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
